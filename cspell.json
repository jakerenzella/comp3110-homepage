{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB,en",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words", "typescript", "node", "softwareTerms"],
  "ignorePaths": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "public/**",
    "package-lock.json",
    "project-words.txt"
  ],
  "ignoreRegExpList": [
    "MarkdownLink",
    "HexValues",
    "/https?:\\/\\/[^\\s)\"'`]+/",
    "/`[^`]*`/",
    "/^```[\\s\\S]*?^```/gm",
    "/\\{\\/\\*[\\s\\S]*?\\*\\/\\}/"
  ],
  "flagWords": [
    "adn",
    "hte",
    "nad",
    "recieve",
    "recieved",
    "seperate",
    "seperately",
    "teh",
    "thier",
    "wich"
  ]
}
